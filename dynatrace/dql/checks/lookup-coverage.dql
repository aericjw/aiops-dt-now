// Coverage check: for every distinct dt_entity_key observed on live Davis
// events in the window, confirm the v4 mapping table (the current
// live/authoritative one -- see scripts/upload-lookup.sh for why this
// instance has four lookup tables, v1 through v4, and why the load path
// here must always match extract_events.dql's) resolves now_ci_class
// and bind_strategy. Any row with a null in either column means the lookup
// table is missing that entity key and extract_events.dql will ship a null
// bind for it.
//
// I2 fix (final whole-branch review, 2026-09-08): this was still pointed at
// _v2 while extract_events.dql and the deployed workflow had already moved
// on to _v4 -- this check was silently validating a stale, unused table.
fetch dt.davis.events, from:-24h
| fieldsAdd raw = arrayFirst(coalesce(smartscape.affected_entity.types, affected_entity_types))
| fieldsAdd dt_entity_key = if(isNull(raw), "__unknown__",
    else: lower(if(startsWith(raw, "dt.entity."), substring(raw, from: 10), else: raw)))
| summarize events = count(), by: {dt_entity_key}
| lookup [load "/lookups/dt_to_snow_cmdb_mapping_v4"],
    sourceField: dt_entity_key, lookupField: dt_entity_key,
    fields: {now_ci_class, bind_strategy}
| filter isNull(now_ci_class) or isNull(bind_strategy)
| sort events desc
